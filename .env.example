# ==============================================================================
# Folsom AQI Navigator - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual API keys.
# DO NOT commit your actual `.env` file to version control.

# AirNow API Key (Required for fetching ground-truth current PM2.5 readings)
# Get one at: https://docs.airnowapi.org/
AIRNOW_API_KEY="your_airnow_api_key_here"

# Google Gemini API Key (Required for AI Summary and Q&A layer)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# GitHub Personal Access Token (Required ONLY if hitting private CDN/repo caches)
# Can be left blank for local development.
GITHUB_TOKEN=""

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
